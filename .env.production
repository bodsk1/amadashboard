# Production Environment Configuration
GENERATE_SOURCEMAP=false
REACT_APP_ENV=production
DISABLE_ESLINT_PLUGIN=true

# Password gate - SHA-256 hash of the dashboard password (change by replacing the hash).
REACT_APP_PASSWORD_HASH=b2c6e449d63e6cc86375fd5d0411f1c2521deb11e849fee89152344774e6185e
# To generate: echo -n "yourpassword" | shasum -a 256

# Build optimizations
INLINE_RUNTIME_CHUNK=false
IMAGE_INLINE_SIZE_LIMIT=10000

# Performance
REACT_APP_ENABLE_PROFILER=false
